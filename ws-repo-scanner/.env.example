PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4200

# Sin DB_HOST se usa un JobStore en memoria (no persiste).
# El modelo de datos debe existir en la DB antes de arrancar: db/schema.sql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SCHEMA=sch_repo_scanner
DB_SSL=false
DB_LOGGING=false

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=1024

# Service account de Firebase. En local, ruta al JSON descargado de la consola;
# en AWS llega como FIREBASE_SERVICE_ACCOUNT (variable inyectada desde Secrets Manager).
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
# true -> exige el token de Firebase en /api/v1/jobs y /ws
AUTH_ENABLED=false
