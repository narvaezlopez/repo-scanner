PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4200

# Sin DB_HOST se usa un JobStore en memoria (no persiste).
# El modelo de datos debe existir en la DB antes de arrancar: db/schema.sql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SCHEMA=sch_repo_scanner
DB_LOGGING=false

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=1024
